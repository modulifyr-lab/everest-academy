---
import Layout from "../layouts/Layout.astro";

const stats = [
  { to: 850, suffix: "+", label: "Students" },
  { to: 52, suffix: "", label: "Teachers" },
  { to: 22, suffix: "", label: "Years" },
  { to: 98, suffix: "%", label: "Placement" },
];

const programs = [
  {
    title: "Early Years",
    ages: "Ages 3–5",
    desc: "Play-based Montessori-influenced programme building foundations for lifelong learning.",
    href: "/academics#early-years",
  },
  {
    title: "Cambridge Primary",
    ages: "Grades 1–5",
    desc: "Seven core subjects with Cambridge Checkpoint assessments at Grade 5.",
    href: "/academics#cambridge-primary",
  },
  {
    title: "Cambridge IGCSE",
    ages: "Grades 6–10",
    desc: "18 subjects available. External exams in May and October each year.",
    href: "/academics#cambridge-igcse",
  },
  {
    title: "Cambridge A-Levels",
    ages: "Grades 11–12",
    desc: "Science, Commerce, and Humanities streams with university counselling from Grade 10.",
    href: "/academics#cambridge-a-levels",
  },
];

const values = [
  { title: "Small Class Sizes", desc: "Maximum 20 students per class for personalised attention" },
  { title: "Postgraduate Faculty", desc: "70% of teachers hold postgraduate qualifications" },
  { title: "World-Class Facilities", desc: "Science labs, library, sports complex, and smart classrooms" },
  { title: "Strong Values", desc: "Integrity, curiosity, and Nepali identity at our core" },
  { title: "Safe Campus", desc: "24/7 security with dedicated health and counselling services" },
  { title: "Proven Track Record", desc: "98% university placement rate over the past decade" },
];

const faculty = [
  { name: "Ms. Sunita Pradhan", role: "Head of Sciences", detail: "M.Sc. Chemistry, 14 years experience" },
  { name: "Mr. Ramesh Karki", role: "Head of Mathematics", detail: "M.Ed., 11 years experience" },
  { name: "Ms. Anisha Shrestha", role: "Head of English", detail: "B.A. English Lit, 9 years experience" },
];

const events = [
  { date: "Aug 14", title: "Open Day", type: "Admissions" },
  { date: "Aug 22", title: "Science Exhibition", type: "Academic" },
  { date: "Sep 5", title: "Admissions Deadline", type: "Admissions" },
];
---

<Layout
  title="Home"
  description="Everest Academy provides world-class Cambridge education rooted in Nepali identity. Lazimpat, Kathmandu."
>
  <!-- HERO -->
  <section class="relative min-h-[100svh] flex items-end overflow-hidden bg-navy pt-20">
    <div class="absolute inset-0">
      <div class="absolute inset-0 bg-gradient-to-b from-navy-mid/50 via-navy/80 to-navy"></div>
      <svg class="absolute bottom-0 left-0 h-[40%] w-full text-navy-dark opacity-60" viewBox="0 0 1440 400" preserveAspectRatio="none" fill="currentColor">
        <path d="M0 400V200L180 150L360 220L540 120L720 200L900 140L1080 210L1260 100L1440 160V400H0Z"></path>
        <path d="M0 400V280L240 220L480 300L720 240L960 310L1200 260L1440 320V400H0Z" opacity="0.6"></path>
      </svg>
    </div>

    <div class="relative z-10 mx-auto w-full max-w-[1400px] px-6 pb-20 md:px-10 md:pb-28">
      <div class="max-w-3xl">
        <p class="eyebrow mb-6 text-gold" data-hero-line style="opacity:0">
          Cambridge Certified · IGCSE & A-Levels · Grade N–12
        </p>
        <h1 class="font-display text-balance text-5xl font-bold leading-[1.08] text-cream md:text-7xl">
          <span class="block overflow-hidden pb-2">
            <span class="block pb-1" data-hero-line style="opacity:0">Where Nepal's Next</span>
          </span>
          <span class="block overflow-hidden pb-2">
            <span class="block text-gold pb-1" data-hero-line style="opacity:0">Generation</span>
          </span>
          <span class="block overflow-hidden pb-2">
            <span class="block pb-1" data-hero-line style="opacity:0">Takes Shape</span>
          </span>
        </h1>
        <p class="mt-8 max-w-xl text-lg text-cream/80" data-hero-line style="opacity:0">
          Everest Academy provides world-class Cambridge education rooted in Nepali identity.
        </p>
        <div class="mt-10 flex flex-col gap-4 sm:flex-row" data-hero-line style="opacity:0">
          <a href="/admissions" class="eyebrow rounded-full bg-gold px-8 py-4 text-navy font-bold transition-all hover:bg-gold-light hover:shadow-lg">
            Apply for 2025–26
          </a>
          <a href="/contact" class="eyebrow rounded-full border-2 border-white px-8 py-4 text-white font-bold transition-all hover:bg-white hover:text-navy">
            Schedule a Campus Visit
          </a>
        </div>
      </div>

      <div class="mt-16 grid grid-cols-2 gap-6 md:grid-cols-4" data-hero-line style="opacity:0">
        <div class="border-l-2 border-gold pl-4">
          <p class="font-display text-3xl font-bold text-gold">Cambridge</p>
          <p class="text-sm text-cream/70">Certified</p>
        </div>
        <div class="border-l-2 border-gold pl-4">
          <p class="font-display text-3xl font-bold text-gold">98%</p>
          <p class="text-sm text-cream/70">Placement</p>
        </div>
        <div class="border-l-2 border-gold pl-4">
          <p class="font-display text-3xl font-bold text-gold">2003</p>
          <p class="text-sm text-cream/70">English Medium</p>
        </div>
        <div class="border-l-2 border-gold pl-4">
          <p class="font-display text-3xl font-bold text-gold">Smart</p>
          <p class="text-sm text-cream/70">Classrooms</p>
        </div>
      </div>
    </div>
  </section>

  <!-- STATS -->
  <section class="bg-navy-dark px-6 py-16 md:px-10">
    <div class="mx-auto grid max-w-[1400px] grid-cols-2 gap-8 md:grid-cols-4">
      {stats.map((s) => (
        <div class="text-center" data-reveal>
          <p class="font-display text-5xl font-bold text-gold md:text-6xl">
            <span data-count-to={s.to}>0</span>{s.suffix}
          </p>
          <p class="eyebrow mt-2 text-cream/70">{s.label}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- PROGRAMMES -->
  <section class="px-6 py-24 md:px-10 md:py-32">
    <div class="mx-auto max-w-[1400px]">
      <div class="mb-16 max-w-2xl" data-reveal>
        <p class="eyebrow mb-4 text-gold">Academic Programmes</p>
        <h2 class="font-display text-balance text-4xl font-bold text-navy md:text-5xl">
          A Cambridge Pathway from Early Years to A-Levels
        </h2>
      </div>

      <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-4">
        {programs.map((p) => (
          <a href={p.href} class="group flex flex-col h-full rounded-2xl border border-border bg-white p-8 transition-all hover:border-gold hover:shadow-xl" data-reveal>
            <p class="eyebrow mb-3 text-green">{p.ages}</p>
            <h3 class="font-display text-2xl font-bold text-navy">{p.title}</h3>
            <p class="mt-3 text-muted">{p.desc}</p>
            <p class="eyebrow mt-6 mt-auto pt-4 text-gold transition-transform group-hover:translate-x-2">Learn more →</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- WHY CHOOSE US -->
  <section class="bg-navy px-6 py-24 md:px-10 md:py-32">
    <div class="mx-auto max-w-[1400px]">
      <div class="mb-16 max-w-2xl" data-reveal>
        <p class="eyebrow mb-4 text-gold">Why Everest Academy</p>
        <h2 class="font-display text-balance text-4xl font-bold text-cream md:text-5xl">
          The Foundation for Exceptional Futures
        </h2>
      </div>

      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {values.map((v) => (
          <div class="rounded-xl border border-cream/10 bg-navy-mid/50 p-8" data-reveal>
            <h3 class="font-display text-xl font-bold text-cream">{v.title}</h3>
            <p class="mt-2 text-cream/70">{v.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FACULTY SPOTLIGHT -->
  <section class="px-6 py-24 md:px-10 md:py-32">
    <div class="mx-auto max-w-[1400px]">
      <div class="mb-16 flex flex-col justify-between gap-6 md:flex-row md:items-end" data-reveal>
        <div>
          <p class="eyebrow mb-4 text-gold">Our Faculty</p>
          <h2 class="font-display text-4xl font-bold text-navy md:text-5xl">The People Who Make the Difference</h2>
        </div>
        <a href="/faculty" class="eyebrow text-navy hover:text-gold">View all faculty →</a>
      </div>

      <div class="grid gap-8 md:grid-cols-3">
        {faculty.map((f) => (
          <div class="rounded-2xl border border-border bg-white p-8 text-center" data-reveal>
            <div class="mx-auto h-20 w-20 rounded-full bg-navy flex items-center justify-center">
              <span class="font-display text-2xl font-bold text-gold">{f.name.split(' ').map(n => n[0]).join('').slice(0,2)}</span>
            </div>
            <h3 class="mt-4 font-display text-xl font-bold text-navy">{f.name}</h3>
            <p class="eyebrow mt-1 text-green">{f.role}</p>
            <p class="mt-2 text-sm text-muted">{f.detail}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- EVENTS -->
  <section class="bg-cream px-6 py-24 md:px-10 md:py-32">
    <div class="mx-auto max-w-[1400px]">
      <div class="mb-16" data-reveal>
        <p class="eyebrow mb-4 text-gold">Upcoming Events</p>
        <h2 class="font-display text-4xl font-bold text-navy md:text-5xl">Mark Your Calendar</h2>
      </div>

      <div class="grid gap-6 md:grid-cols-3">
        {events.map((e) => (
          <div class="flex items-center gap-6 rounded-xl border border-border bg-white p-6" data-reveal>
            <div class="flex flex-col items-center rounded-lg bg-navy px-4 py-3 text-center">
              <span class="font-display text-lg font-bold text-gold">{e.date.split(' ')[0]}</span>
              <span class="text-xs text-cream/70">{e.date.split(' ')[1]}</span>
            </div>
            <div>
              <h3 class="font-display text-lg font-bold text-navy">{e.title}</h3>
              <p class="eyebrow text-muted">{e.type}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-navy px-6 py-24 text-center md:px-10 md:py-32">
    <div class="mx-auto max-w-2xl" data-reveal>
      <h2 class="font-display text-balance text-4xl font-bold text-cream md:text-5xl">
        Applications Now Open for 2025–26
      </h2>
      <p class="mt-6 text-lg text-cream/80">
        Give your child the foundation they deserve. Schedule a campus visit or begin the admissions process today.
      </p>
      <div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a href="/admissions" class="eyebrow rounded-full bg-gold px-8 py-4 text-navy font-bold transition-all hover:bg-gold-light hover:shadow-lg">
          Apply Now
        </a>
        <a href="/contact" class="eyebrow rounded-full border-2 border-white px-8 py-4 text-white font-bold transition-all hover:bg-white hover:text-navy">
          Contact Us
        </a>
      </div>
    </div>
  </section>

  <script>
    import { initReveal, initHeroIntro, initCounters } from "../scripts/animations.js";

    initHeroIntro();
    initReveal();
    initCounters();
  </script>
</Layout>